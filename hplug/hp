#!/usr/bin/env python3
"""hp: one-command workflow for Horizon server plugins (hplug).

  hp new NAME            scaffold plugins/NAME (Cargo.toml, src/lib.rs, test.script)
  hp build               regenerate the runner from plugins/* and compile the server engine
  hp test [NAME...]      build, start a throw-away offline server, run each plugin's test.script
                         with hp-client, print PASS/FAIL, stop the server (exit 1 on any failure)
  hp run [DIR]           start a persistent test server in DIR (default ./srv) on 127.0.0.1:25570
  hp list                plugins that will be linked

Environment (all optional): HP_PROFILE=fast|release  HP_JOBS=4  HP_RESOURCES=<prepared 26.3 folder>
  HP_PORT=25570  CARGO=cargo  HP_PARALLEL_TICK=0|1
  HP_BIN_DIR=<dir with hplug-runner horizon-server hp-client> HP_NO_BUILD=1   run tests on a box that cannot compile (4 GB VPS)
Run it from anywhere; it works relative to the Horizon checkout it lives in (hplug/hp).
"""
import os, pathlib, re, shutil, subprocess, sys, tempfile, time

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parent
PLUGINS = HERE / "plugins"
PROFILE = os.environ.get("HP_PROFILE", "fast")
JOBS = os.environ.get("HP_JOBS", "4")
PORT = os.environ.get("HP_PORT", "25570")
RES = os.environ.get("HP_RESOURCES", str(ROOT / ".local/horizon-client/26.3"))
CARGO = os.environ.get("CARGO", "cargo")
TARGET = pathlib.Path(os.environ["HP_BIN_DIR"]) if os.environ.get("HP_BIN_DIR") else ROOT / "target" / ("release" if PROFILE == "release" else PROFILE)
NO_BUILD = bool(os.environ.get("HP_NO_BUILD"))   # use prebuilt binaries (hplug-runner, horizon-server, hp-client) from HP_BIN_DIR

def die(m):
    print("hp: " + m, file=sys.stderr); sys.exit(2)

def plugin_names():
    names = sorted(p.name for p in PLUGINS.iterdir() if (p / "Cargo.toml").exists())
    only = os.environ.get("HP_ONLY")   # comma list: link and test only these plugins (parallel work lanes)
    return [n for n in names if n in only.split(",")] if only else names

def crate(name):
    m = re.search(r'^name\s*=\s*"([^"]+)"', (PLUGINS / name / "Cargo.toml").read_text(), re.M)
    return m.group(1)

def gen():
    names = plugin_names()
    deps = "".join(f'{crate(n)} = {{ path = "../plugins/{n}" }}\n' for n in names)
    (HERE / "runner/Cargo.toml").write_text(f'''# GENERATED by hplug/hp gen. Do not edit.
[package]
name = "hplug-runner"
version = "0.1.0"
edition = "2024"

[dependencies]
horizon-client = {{ path = "../../crates/horizon-client", default-features = false }}
horizon-threads = {{ path = "../../crates/horizon-threads" }}
horizon-mods = {{ path = "../../crates/horizon-mods", default-features = false, features = ["index"] }}
hplug = {{ path = "../sdk" }}
{deps}''')
    items = ", ".join(f"{crate(n).replace('-', '_')}::plugin()" for n in names)
    (HERE / "runner/src/main.rs").write_text(f'''// GENERATED by hplug/hp gen. Do not edit.
#[global_allocator]
static ALLOCATOR: horizon_threads::Allocator = horizon_threads::ALLOCATOR;
static MOD_API_LEVEL: [u8; horizon_mods::api_level::MARK.len()] = horizon_mods::api_level::MARK;

fn main() {{
    std::hint::black_box(&MOD_API_LEVEL);
    let plugins = vec![{items}];
    let ids: Vec<&'static str> = plugins.iter().map(|p| &*Box::leak(p.id().to_owned().into_boxed_str())).collect();
    horizon_client::mod_api::name_mods(Box::leak(ids.into_boxed_slice()));
    let mods: horizon_client::mod_api::Mods = plugins.into_iter().map(|p| Box::new(p) as Box<dyn horizon_client::mod_api::Hooks>).collect::<Vec<_>>().into();
    horizon_client::entry::main_with(mods);
}}
''')

def cargo_build(*pkgs):
    cmd = ["nice", "-n", "19", CARGO, "build", "--profile", PROFILE, "-j", JOBS]
    for p in pkgs: cmd += ["-p", p]
    print("+", " ".join(cmd)); r = subprocess.run(cmd, cwd=ROOT)
    if r.returncode: die("cargo build failed (read the first 'error' above; hplug API is in hplug/sdk/src/lib.rs)")

def cmd_new(name):
    if not re.fullmatch(r"[a-z][a-z0-9_]*", name or ""): die("NAME: lowercase letters, digits, underscore")
    d = PLUGINS / name
    if d.exists(): die(f"{d} exists")
    (d / "src").mkdir(parents=True)
    (d / "Cargo.toml").write_text(f'[package]\nname = "hplug-plugin-{name}"\nversion = "0.1.0"\nedition = "2024"\n\n[dependencies]\nhplug = {{ path = "../../sdk" }}\n')
    (d / "src/lib.rs").write_text(f'''use hplug::Plugin;

pub fn plugin() -> Plugin {{
    Plugin::new("{name}")
        .command("{name}", 0, |ctx, _args| {{
            ctx.reply("{name} works");
            Ok(())
        }})
}}
''')
    (d / "test.script").write_text(f"# hp-client script: ops separated by ';' or newlines. See hplug/testclient/src/main.rs\nwait 1; cmd {name}; expect {name} works\n")
    print(f"created {d}. Next: hp test {name}")

def cmd_build():
    if NO_BUILD:
        print(f"HP_NO_BUILD: using prebuilt binaries in {TARGET}"); return
    gen(); cargo_build("hplug-runner", "hp-client", "horizon-server")

def write_conf(srv, port):
    t = (srv / "server.toml").read_text()
    t = re.sub(r'^(path = )".*?"', f'\\1"{TARGET / "hplug-runner"}"', t, flags=re.M)
    t = re.sub(r'^(resources = )".*?"', f'\\1"{RES}"', t, flags=re.M)
    t = re.sub(r'^(port = )\d+', f'\\g<1>{port}', t, flags=re.M)
    t = re.sub(r'^bind = ""( +# listen.*)$', r'bind = "127.0.0.1"\1', t, flags=re.M)
    t = re.sub(r'(\[panel\]\nbind = )".*?"', r'\1""', t)
    t = re.sub(r'(\[discord\][^\[]*?enabled = )true', r'\1false', t, flags=re.S)
    t = re.sub(r'(\[world\][^\[]*?game_mode = )"survival"', r'\1"creative"', t, flags=re.S)
    parallel = os.environ.get("HP_PARALLEL_TICK")
    if parallel is not None:
        if parallel not in ("0", "1"):
            die("HP_PARALLEL_TICK must be 0 or 1")
        t, count = re.subn(r"^parallel_tick = (true|false)", "parallel_tick = " + ("true" if parallel == "1" else "false"), t, flags=re.M)
        if count != 1:
            die("server.toml has no unique engine.parallel_tick setting")
    (srv / "server.toml").write_text(t)

def init_server(srv, port):
    srv.mkdir(parents=True, exist_ok=True)
    hs = str(TARGET / "horizon-server")
    if not (srv / "server.toml").exists():
        r = subprocess.run([hs, "init", "--eula", "--world", "world", "--seed", "12345", "--port", port, "--no-whitelist", "--offline", "--op", "Tester", "--yes"], cwd=srv, capture_output=True, text=True)
        if r.returncode: die("horizon-server init failed:\n" + r.stdout + r.stderr)
    write_conf(srv, port)
    return hs

def wait_ready(log, proc, secs=90):
    t0 = time.time()
    while time.time() - t0 < secs:
        if proc.poll() is not None: die("server exited early; see " + str(log))
        if log.exists() and "Done (" in log.read_text(errors="replace"): return
        time.sleep(0.5)
    die("server did not become ready; see " + str(log))

def cmd_run(d):
    srv = pathlib.Path(d or "srv").resolve(); gen_needed = not (TARGET / "hplug-runner").exists()
    if gen_needed: die("run `hp build` first")
    hs = init_server(srv, PORT)
    print(f"starting server in {srv} on 127.0.0.1:{PORT} (Ctrl-C stops it)")
    os.execv(hs, [hs, "run", "--dir", str(srv)])

def read_script(path):
    """-> (client name, expect_refused or None, script text). Directives are comments:
    '# client: NAME' and '# expect-refused: TEXT'."""
    name, refused, ops = "Tester", None, []
    for l in path.read_text().splitlines():
        l = l.strip()
        if m := re.match(r"#\s*client:\s*(\S+)", l): name = m.group(1)
        elif m := re.match(r"#\s*expect-refused:\s*(.+)", l): refused = m.group(1)
        elif l and not l.startswith("#"): ops.append(l)
    return name, refused, " ; ".join(ops)

def cmd_test(names):
    cmd_build()
    names = names or [n for n in plugin_names() if (PLUGINS / n / "test.script").exists()]
    scripts_of = lambda n: sorted((PLUGINS / n).glob("test*.script"))
    port = str(int(PORT) + 1)
    failed = []
    for n in names:
        tmp = pathlib.Path(tempfile.mkdtemp(prefix=f"hp-test-{n}-"))
        hs = init_server(tmp, port)
        if n != "horizonsauth":          # the auth plugin would freeze every other plugin's test player
            (tmp / "config/hplug").mkdir(parents=True, exist_ok=True); (tmp / "config/hplug/horizonsauth.json").write_text('{"enabled": false}')
        if n != "mapvideo":              # the intro lock would put every other plugin's test player in spectator
            (tmp / "config/hplug").mkdir(parents=True, exist_ok=True); (tmp / "config/hplug/mapvideo.json").write_text('{"intro_enabled": false}')
        if n != "skins":                 # no Mojang lookups (network, profile refresh) in other plugins' tests
            (tmp / "config/hplug").mkdir(parents=True, exist_ok=True); (tmp / "config/hplug/skins.json").write_text('{"auto_by_name": false}')
        if n != "locatorbarlimiter":     # keep vanilla waypoint ranges for the other plugins' tests
            (tmp / "config/hplug").mkdir(parents=True, exist_ok=True); (tmp / "config/hplug/locatorbarlimiter.json").write_text('{"enabled": false}')
        fx = PLUGINS / n / "fixture"
        if fx.is_dir():
            shutil.copytree(fx, tmp, dirs_exist_ok=True, ignore=shutil.ignore_patterns("server.toml.append", "properties.toml"))   # files the plugin expects (stats, config...)
            if (fx / "properties.toml").exists():                      # extra keys for the [properties] table, e.g. spawn-protection = 0
                t = (tmp / "server.toml").read_text()
                (tmp / "server.toml").write_text(t.replace("\n[properties]\n", "\n[properties]\n" + (fx / "properties.toml").read_text() + "\n", 1))
            if (fx / "server.toml.append").exists():                   # extra server.toml settings for this plugin's tests
                with open(tmp / "server.toml", "a") as t: t.write("\n" + (fx / "server.toml.append").read_text())
        log = tmp / "server.log"
        f = open(log, "w")
        proc = subprocess.Popen(["nice", "-n", "19", hs, "run", "--dir", str(tmp)], stdout=f, stderr=subprocess.STDOUT)
        try:
            wait_ready(log, proc)
            ok = True
            for sp in scripts_of(n):               # test.script, test2.script, ... in order, same server
                cname, refused, script = read_script(sp)
                cmd = [str(TARGET / "hp-client"), "--server", f"127.0.0.1:{port}", "--name", cname, "--script", script]
                if refused: cmd += ["--expect-refused", refused]
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
                if r.returncode:
                    ok = False
                    # the failing lines first (the tail below can scroll them out), then the tail
                    bad = [l for l in r.stdout.splitlines() if "FAIL" in l or "script error" in l]
                    print(f"--- {sp.name} FAILED: " + (" | ".join(bad[:8]) if bad else "(no FAIL line printed)"))
                    print(f"--- {sp.name} output ---\n" + r.stdout[-int(os.environ.get("HP_OUT_CHARS", "2000")):], r.stderr[-1000:])
            print(f"[{'PASS' if ok else 'FAIL'}] {n}   (server log: {log})")
            if not ok: failed.append(n)
        finally:
            proc.terminate()
            try: proc.wait(20)
            except subprocess.TimeoutExpired: proc.kill()
            f.close()
    sys.exit(1 if failed else 0)

def main():
    a = sys.argv[1:]
    if not a: print(__doc__); return
    c, rest = a[0], a[1:]
    {"new": lambda: cmd_new(rest[0] if rest else None), "gen": gen, "build": cmd_build,
     "test": lambda: cmd_test(rest), "run": lambda: cmd_run(rest[0] if rest else None),
     "list": lambda: print("\n".join(plugin_names()))}.get(c, lambda: die("unknown command " + c))()

main()
