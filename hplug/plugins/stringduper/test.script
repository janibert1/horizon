# breaking an ATTACHED tripwire hook (survival) drops one extra string. Horizon's setblock does not compute
# `attached` from a tripwire line and a lone hook resets it within ticks, so the break follows setblock at once, three tries (any one drop passes).
cmd gamemode survival
wait 1
cmd setblock 96 144 -32 minecraft:tripwire_hook[attached=true,facing=north]
break 96 144 -32
cmd setblock 96 144 -32 minecraft:tripwire_hook[attached=true,facing=north]
break 96 144 -32
cmd setblock 96 144 -32 minecraft:tripwire_hook[attached=true,facing=north]
break 96 144 -32
wait 2
cmd execute as @e[type=item] if data entity @s Item{id:"minecraft:string"}
expect commands.execute.conditional.pass_count
